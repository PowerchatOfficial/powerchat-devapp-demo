# PowerChat Developer API demo — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Nothing in here is ever sent to the browser by the demo
# server, and none of it is printed to stdout.
#
# WHICH VARIABLES DO I ACTUALLY NEED?
#   server.js (the browser demo)  → BASE_URL, CLIENT_ID, CLIENT_SECRET, REDIRECT_URI
#                                   (+ WEBHOOK_SECRET to receive webhooks)
#   examples/*.js (headless)      → BASE_URL, ACCESS_TOKEN, STREAMER
#                                   (+ REFRESH_TOKEN, CLIENT_ID, CLIENT_SECRET so
#                                     they can refresh instead of dying on a 401 —
#                                     REQUIRED for anything that runs longer than
#                                     ~10 minutes: 05, 13, and the scenario servers)
# Run the server once, connect, and it will hold a grant in memory — the
# headless scripts want their own copy in ACCESS_TOKEN/STREAMER.

# ---------------------------------------------------------------- API host

# Which PowerChat to talk to. Production is https://powerchat.live.
# Point this at your own instance for local development (see the README).
POWERCHAT_BASE_URL=https://powerchat.live

# ---------------------------------------------------------- app credentials
# All three come from the PowerChat dashboard: user menu -> Developer API ->
# your app. Registering an app requires 2FA on your PowerChat account.

# Public client id, always starts with pca_. Safe to ship in a client.
POWERCHAT_CLIENT_ID=pca_xxxxxxxxxxxxxxxxxxxxxxxx

# Confidential client secret, starts with pcs_. SHOWN EXACTLY ONCE at
# registration — only a hash is stored, so save it now or rotate it later.
# Leave BLANK for a public client (SPA, mobile, desktop): those must not ship a
# secret and rely on PKCE alone, which src/oauth.js always sends.
POWERCHAT_CLIENT_SECRET=pcs_xxxxxxxxxxxxxxxxxxxxxxxx

# Where PowerChat sends the streamer back after consent. Redirect URIs are
# EXACT-match — scheme, host, port, path, and query all have to be identical to
# a URI registered on the app. No wildcards, no prefix matching. https is
# required in production; http://localhost is allowed in development.
# server.js derives its callback route from this value. The callback lands on
# the loopback CONTROL server (PORT below), so this stays a localhost URI —
# never the tunnel hostname, which only ever reaches the webhook receiver.
POWERCHAT_REDIRECT_URI=http://localhost:4000/oauth/callback

# ------------------------------------------------------------------ webhooks

# Signing secret for your webhook receiver, starts with pcw_. Dashboard ->
# your app -> Webhooks, shown once when you save the receiver URL.
# Without it, server.js rejects every delivery: unverified webhooks are an open
# endpoint anyone can post fake donations to.
# Local development needs a public HTTPS URL — see "Webhooks" in the README.
POWERCHAT_WEBHOOK_SECRET=pcw_xxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------- headless script tokens

# A token pair for one connected streamer, so examples/*.js can run without a
# browser. The quickest way to get one: start server.js and click Connect —
# the OAuth flow ends with a live grant, and `node examples/01-whoami.js`
# confirms which streamer a token belongs to.
#
# Access tokens are valid ~10 minutes. Refresh tokens rotate on EVERY use — the
# old one dies the moment the new one is minted, and replaying a rotated token
# revokes the entire family. Scripts built on src/credentials.js (the
# long-running ones) refresh on a 401 and write the rotated pair back to THIS
# file automatically; keep exactly one process refreshing a given pair.
POWERCHAT_ACCESS_TOKEN=
POWERCHAT_REFRESH_TOKEN=

# The streamer username that authorized the token above. It is the :username
# path segment of every REST call — one token belongs to exactly one streamer.
# `node examples/01-whoami.js` prints it.
POWERCHAT_STREAMER=

# ------------------------------------------------------------------- runtime

# server.js runs TWO listeners:
#   PORT          the control server — UI, OAuth callback, /api/*. Binds to
#                 127.0.0.1 only. Change it and POWERCHAT_REDIRECT_URI together,
#                 then re-register the redirect URI in the dashboard.
#   WEBHOOK_PORT  the signed-webhook receiver. Binds to WEBHOOK_HOST (0.0.0.0).
#                 This is the ONLY port you tunnel: `ngrok http 4001`.
PORT=4000
WEBHOOK_PORT=4001
WEBHOOK_HOST=0.0.0.0

# ---- Scenario-specific (only needed for the scenarios/ demos) ----------------
# scenarios/paid-memberships runs two listeners:
#   MEMBERSHIP_PORT        public — webhook, return page, order-status poll.
#                          Tunnel THIS one: `ngrok http 4010`.
#   MEMBERSHIP_ADMIN_PORT  loopback only — storefront, /join (mints intents),
#                          /admin/reconcile (spends read budget). Never exposed.
# MEMBERSHIP_RETURN_URI is where PowerChat returns the viewer after paying; it
# lands on the PUBLIC listener and must be one of your app's REGISTERED
# redirect URIs, matched exactly (through the tunnel: https://<tunnel>/membership/return).
MEMBERSHIP_RETURN_URI=http://localhost:4010/membership/return
MEMBERSHIP_PORT=4010
MEMBERSHIP_ADMIN_PORT=4012
# scenarios/charity-campaign: the public fundraiser page.
CAMPAIGN_PORT=4020
# scenarios/community-bot: webhook receiver for the community announcer.
COMMUNITY_BOT_PORT=4030
